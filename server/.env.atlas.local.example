# Copy this file to server/.env.atlas.local and populate it locally.
# Keep the real file ignored and never put credentials in VITE_* variables.
URBANKART_DB_PROFILE=atlas-demo
MONGODB_URI=mongodb+srv://<database-user>:<password>@<atlas-host>/urbankart_atlas_demo?retryWrites=true&w=majority
URBANKART_EXPECTED_DB_NAME=urbankart_atlas_demo
URBANKART_DB_ENV=atlas-demo
URBANKART_ATLAS_CLUSTER_NAME=urbankart-cluster
# SHA-256 of the lowercase SRV hostname only; this pins the selected endpoint.
URBANKART_ATLAS_HOST_SHA256=<64-character-lowercase-sha256>
# Set only after a live Atlas hello/buildInfo audit confirms the topology/version.
URBANKART_TXN_TOPOLOGY_CONFIRMED=replicaSet
JWT_SECRET=<independent-random-secret-at-least-32-characters>
JWT_EXPIRES_IN=1h
