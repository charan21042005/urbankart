# ==========================================
# UrbanKart Environment Configuration
# ==========================================
# Note: Do not place real passwords/secrets in this file!
# Copy this file to '.env' and populate with actual credentials.

# Application Environment (e.g., development, production)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/urbankart?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# Database safety-tool gates; leave blank until the Atlas project/cluster is
# independently confirmed as isolated development data. These are assertions,
# not automatic proof that the selected cluster is non-production.
URBANKART_EXPECTED_DB_NAME=
URBANKART_DB_ENV=
URBANKART_TEST_DB_NAME=
URBANKART_TXN_TOPOLOGY_CONFIRMED=
URBANKART_TXN_REPLICA_SET_NAME=
